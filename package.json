    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint",
    "test": "npm run test:flow-vwap && npm run test:playbook && npm run test:invariants && npm run test:viewport && npm run test:fsm && npm run test:alpha-scorer && npm run test:persistence && npm run test:agentic-supervisor && npm run test:execution-guards && npm run test:quant-audit && npm run test:discord-webhook && npm run test:phase2 && npm run test:zero",
    "test:flow-vwap": "npx tsx lib/__tests__/flowGammaVwap.test.ts",
    "test:playbook": "npx tsx lib/__tests__/playbookEngine.test.ts",
    "test:invariants": "npx tsx scripts/verifyExecutionInvariants.ts",
    "test:viewport": "npx tsx --test lib/__tests__/viewportAndDurationInvariants.test.ts",
    "test:fsm": "npx tsx --test lib/__tests__/gaiaSignalFsm.test.ts",
    "test:alpha-scorer": "npx tsx --test lib/__tests__/alphaScorer.test.ts",
    "test:persistence": "npx tsx --test lib/__tests__/persistenceStore.test.ts",
    "test:agentic-supervisor": "npx tsx --test lib/__tests__/agenticSupervisor.test.ts",
    "test:execution-guards": "npx tsx --test lib/__tests__/executionGuards.test.ts",
    "test:quant-audit": "npx tsx --test lib/__tests__/quantAuditRegressions.test.ts",
    "test:discord-webhook": "npx tsx --test lib/__tests__/discordWebhook.test.ts",
    "test:phase2": "npx tsx --test lib/__tests__/phase2ElevationRegressions.test.ts",
    "test:zero": "npx tsx --test lib/__tests__/zeroEngineAndHud.test.ts",
    "test:fsm-optimize": "npx tsx scripts/validateFsmAdaptiveParams.ts",
    "test:routes": "npx tsx scripts/verifyLiveRoutes.ts",
    "daemon:audit": "npx tsx scripts/autoImprovementDaemon.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.10.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.186.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
