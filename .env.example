# ==============================================================================
# Hyperion Environment Configuration Template
# Copy this file to .env.local and populate the secrets as needed.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# Tier-1 Options Chain Feed (Tradier API) - Optional
# If omitted, Hyperion automatically falls back to live CBOE delayed chains
TRADIER_API_KEY=

# Hyperion Alerts Discord Webhook - Optional
# Used for real-time dispatch of King Node migration and execution alerts
DISCORD_WEBHOOK_URL=


